---
---
<!-- ============================================================
     CONTACT — Crimson samurai glow + download CV + social links
     ============================================================ -->
<section id="contacto" class="relative py-28 px-6 bg-slate-950 overflow-hidden">

  <!-- Fondo: resplandor carmesí -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] opacity-[0.06] pointer-events-none"
       style="background: radial-gradient(ellipse, #22d3ee 0%, transparent 70%); transform: translate(30%, -30%);">
  </div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] opacity-[0.04] pointer-events-none"
       style="background: radial-gradient(ellipse, #22d3ee 0%, transparent 70%); transform: translate(-30%, 30%);">
  </div>

  <div class="max-w-4xl mx-auto text-center relative z-10">

    <div class="contact-content aos-init">
      <span class="font-mono text-xs text-crimson tracking-[0.3em] uppercase mb-6 block">— Contacto</span>

      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
        ¿Tu producto de salud necesita un engineer<br/>
        <span class="text-transparent bg-clip-text"
              style="background-image: linear-gradient(135deg, #22d3ee, #3b82f6); -webkit-background-clip: text;">
          que entienda a los usuarios?
        </span>
      </h2>

      <p class="text-slate-400 text-lg max-w-2xl mx-auto mb-12 leading-relaxed font-light">
        Si estás construyendo en salud digital, bienestar organizacional, psicometría o cualquier producto donde entender al usuario no es un bonus, sino el núcleo del diseño — hablemos. También si necesitas escalar infraestructura o integrar IA en un sistema que no puede fallar.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
        <a href="https://wa.me/56938713033?text=Hola%20Franco%2C%20vi%20tu%20portafolio%20y%20me%20interesa%20conversar%20sobre%20una%20posible%20colaboraci%C3%B3n." target="_blank" rel="noopener"
           class="px-8 py-4 bg-cyan-electric hover:bg-cyan-600 text-slate-900 font-semibold rounded transition-all duration-200 flex items-center justify-center gap-2.5 shadow-[0_0_20px_rgba(34,211,238,0.4)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Agendar una conversación
        </a>
        <a href="/Curriculum_vitae_original.pdf" target="_blank" rel="noopener"
           class="px-8 py-4 border border-slate-600 text-slate-300 font-medium rounded hover:border-cyan-electric hover:text-cyan-electric transition-all duration-200 flex items-center justify-center gap-2.5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
          </svg>
          Descargar CV
        </a>
      </div>

      <!-- Separador Samurai -->
      <div class="samurai-line max-w-xs mx-auto mb-12"></div>

      <!-- Social links -->
      <div class="flex justify-center gap-8 mb-16">
        <a href="https://www.linkedin.com/in/francojeria/" target="_blank" rel="noopener"
           class="group flex flex-col items-center gap-2 text-slate-500 hover:text-white transition-colors">
          <div class="w-12 h-12 border border-slate-700 rounded-xl flex items-center justify-center group-hover:border-cyan-electric group-hover:bg-cyan-electric/10 transition-all duration-200">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
            </svg>
          </div>
          <span class="font-mono text-xs">LinkedIn</span>
        </a>
        <a href="https://github.com/jeria88" target="_blank" rel="noopener"
           class="group flex flex-col items-center gap-2 text-slate-500 hover:text-white transition-colors">
          <div class="w-12 h-12 border border-slate-700 rounded-xl flex items-center justify-center group-hover:border-zen-matcha group-hover:bg-zen-matcha/10 transition-all duration-200">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </div>
          <span class="font-mono text-xs">GitHub</span>
        </a>
        <a href="https://endonautas.cl" target="_blank" rel="noopener"
           class="group flex flex-col items-center gap-2 text-slate-500 hover:text-white transition-colors">
          <div class="w-12 h-12 border border-slate-700 rounded-xl flex items-center justify-center group-hover:border-gold group-hover:bg-gold/10 transition-all duration-200">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>
            </svg>
          </div>
          <span class="font-mono text-xs">Endonautas</span>
        </a>

      </div>

      <!-- Footer micro -->
      <p class="font-mono text-xs text-slate-700">
        © 2026 Franco Jeria Castro · Temuco, Chile · Built with Astro + GSAP · Hosted on Cloudflare Pages
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.to('.contact-content', {
    scrollTrigger: { trigger: '#contacto', start: 'top 75%' },
    y: 0, opacity: 1, duration: 1.2, ease: 'power3.out'
  });
</script>
