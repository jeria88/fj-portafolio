---
---
<!-- ============================================================
     SKILLS — Terminal typing animation + progress bars animated
     ============================================================ -->
<section id="habilidades" class="relative py-28 px-6 bg-slate-950 overflow-hidden">

  <!-- Fondo sutil -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[70vw] h-[70vw] opacity-[0.03]"
       style="background: radial-gradient(ellipse, white 0%, transparent 70%); pointer-events: none;">
  </div>

  <div class="max-w-6xl mx-auto">

    <!-- Header -->
    <div class="skills-header aos-init mb-16">
      <span class="font-mono text-xs text-crimson tracking-[0.3em] uppercase mb-4 block">— Stack</span>
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Herramientas<br/>y Dominio</h2>
      <div class="samurai-line w-40 mb-4"></div>
      <p class="text-slate-400 max-w-md">
        Tecnología probada en producción. Más el conocimiento de dominio que hace que los sistemas resuelvan los problemas correctos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">

      <!-- Core Skills: Text (Left) -->
      <div class="skills-bars aos-init space-y-8 pt-4">
        <h3 class="text-xl font-bold text-white mb-2">Core Technical Stack</h3>
        <p class="text-slate-400 text-sm mb-6">Tecnologías orientadas a la construcción de sistemas distribuidos, IA y alto rendimiento.</p>

        <div class="space-y-6">
          <div>
            <h4 class="text-sm text-slate-400 font-mono mb-3">Backend</h4>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1.5 bg-slate-800 border border-cyan-electric/30 rounded text-slate-200 text-sm">Python</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-cyan-electric/30 rounded text-slate-200 text-sm">Django</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-cyan-electric/30 rounded text-slate-200 text-sm">FastAPI</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-cyan-electric/30 rounded text-slate-200 text-sm">PostgreSQL</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-cyan-electric/30 rounded text-slate-200 text-sm">Celery</span>
            </div>
          </div>
          <div>
            <h4 class="text-sm text-slate-400 font-mono mb-3">Frontend</h4>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">Astro</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">React</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">TypeScript</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">Three.js</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">Tailwind</span>
            </div>
          </div>
          <div>
            <h4 class="text-sm text-slate-400 font-mono mb-3">Cloud & Arquitectura</h4>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1.5 bg-slate-800 border border-crimson/30 rounded text-slate-200 text-sm">Cloudflare Workers</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-crimson/30 rounded text-slate-200 text-sm">Oracle Cloud (ARM64)</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-crimson/30 rounded text-slate-200 text-sm">Arquitectura Multi-tenant</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-crimson/30 rounded text-slate-200 text-sm">CI/CD</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-crimson/30 rounded text-slate-200 text-sm">Infrastructure as Code</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-crimson/30 rounded text-slate-200 text-sm">Observability</span>
            </div>
          </div>
          <div>
            <h4 class="text-sm text-slate-400 font-mono mb-3">AI & Data</h4>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1.5 bg-slate-800 border border-gold/30 rounded text-slate-200 text-sm">RAG</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-gold/30 rounded text-slate-200 text-sm">LLM Orchestration & Integration</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-gold/30 rounded text-slate-200 text-sm">Bases de Datos Vectoriales</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-gold/30 rounded text-slate-200 text-sm">LLM Pipelines</span>
            </div>
          </div>
          <div>
            <h4 class="text-sm text-slate-400 font-mono mb-3">Health Tech & Domain Knowledge</h4>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">Psicometría Aplicada</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">UX para Salud Mental</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">Diseño de Experiencias Terapéuticas Digitales</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">Bienestar Organizacional</span>
              <span class="px-3 py-1.5 bg-slate-800 border border-zen-matcha/30 rounded text-slate-200 text-sm">Comportamiento Humano en Sistemas</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Visual: Architecture Diagram (Right) -->
      <div class="skills-visual relative flex justify-center items-center opacity-0 translate-y-8">
        <div class="absolute inset-0 bg-cyan-electric/10 blur-[80px] rounded-full pointer-events-none w-3/4 h-3/4 m-auto"></div>
        
        <!-- Diagrama de arquitectura real -->
        <div class="relative z-10 w-full max-w-md rounded-xl overflow-hidden hover:-translate-y-2 transition-transform duration-500 ease-out shadow-[0_0_30px_rgba(34,211,238,0.15)] border border-slate-700/50">
          <img src="/img/franco/architecture-diagram.jpg" alt="Diagrama de Arquitectura — SaaS Multi-tenant con orquestación de agentes IA" class="w-full h-auto block" loading="lazy" />
          <div class="absolute inset-0 pointer-events-none border border-cyan-electric/20 rounded-xl"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Header reveal
  gsap.to('.skills-header', {
    scrollTrigger: { trigger: '#habilidades', start: 'top 80%' },
    y: 0, opacity: 1, duration: 1, ease: 'power3.out'
  });

  // Image reveal
  gsap.to('.skills-visual', {
    scrollTrigger: { trigger: '#habilidades', start: 'top 70%' },
    opacity: 1,
    y: 0,
    duration: 1.2,
    ease: 'power3.out',
    delay: 0.2
  });

  // Bars reveal
  gsap.to('.skills-bars', {
    scrollTrigger: { trigger: '#habilidades', start: 'top 70%' },
    y: 0, opacity: 1, duration: 1, ease: 'power3.out', delay: 0.3
  });

  // Removed bar animation as the progress bars were replaced by badges
</script>
