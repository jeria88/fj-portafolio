---
---
<!-- ============================================================
     PROJECTS — Real screenshots + device mockups + ScrollTrigger
     ============================================================ -->
<section id="proyectos" class="relative py-28 px-6 bg-slate-950">

  <!-- Header -->
  <div class="max-w-6xl mx-auto mb-24">
    <div class="projects-header aos-init">
      <span class="font-mono text-xs text-cyan-electric tracking-[0.3em] uppercase mb-4 block">— Ingeniería en Producción</span>
      <h2 class="text-4xl md:text-6xl font-bold text-white mb-5 leading-tight">
        Sistemas Reales,<br/>Problemas Reales
      </h2>
      <div class="samurai-line w-40 mb-6"></div>
      <p class="text-slate-400 max-w-xl text-lg leading-relaxed">
        Dos SaaS propios en producción. Uno resuelve un problema de negocio B2B; el otro, un problema que nadie más se había atrevido a digitalizar en el espacio de salud y autoconocimiento.
      </p>
    </div>
  </div>

  <!-- ── PROYECTO 1: ACME Agents ── -->
  <div class="max-w-6xl mx-auto mb-40">
    <div class="acme-card grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Visual: screenshots -->
      <div class="relative h-[500px] order-2 lg:order-1">
        <!-- Desktop bg screenshot -->
        <div class="acme-desktop absolute inset-x-0 top-0 device-frame"
             style="transform: perspective(1200px) rotateY(4deg) rotateX(2deg);">
          <img src="/img/acme/hero.png" alt="ACME Agents desktop hero" class="w-full pt-7 block" loading="lazy" />
        </div>
        <!-- Mobile floats (side-by-side) -->
        <div class="absolute -bottom-4 inset-x-0 flex justify-center gap-6 z-20">
          <div class="acme-mobile-1 w-28 md:w-32 device-frame glow-cyan"
               style="transform: perspective(800px) rotateY(-8deg); border-radius: 16px;">
            <img src="/img/acme/mobile-1.png" alt="ACME móvil" class="w-full pt-7 block rounded-b-[14px]" loading="lazy" />
          </div>
          <div class="acme-mobile-2 w-28 md:w-32 device-frame glow-matcha"
               style="transform: perspective(800px) rotateY(8deg); border-radius: 16px;">
            <img src="/img/acme/mobile-2.png" alt="ACME planes móvil" class="w-full pt-7 block rounded-b-[14px]" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- Texto -->
      <div class="order-1 lg:order-2">
        <div class="flex items-center gap-2 mb-5">
          <span class="px-2.5 py-1 bg-cyan-electric/10 text-cyan-electric text-xs font-mono rounded border border-cyan-electric/20">B2B SaaS</span>
          <span class="px-2.5 py-1 bg-slate-800 text-slate-400 text-xs font-mono rounded border border-slate-700">Multi-tenant</span>
          <span class="px-2.5 py-1 bg-slate-800 text-slate-400 text-xs font-mono rounded border border-slate-700">Producción</span>
        </div>

        <div class="flex items-center gap-4 mb-4">
          <img src="/img/projects/acme-logo.jpg" alt="ACME Agents Logo" class="h-12 w-auto object-contain drop-shadow-[0_0_8px_rgba(34,211,238,0.4)] rounded-md" />
          <h3 class="text-3xl md:text-4xl font-bold text-white">ACME Agents</h3>
        </div>
        <p class="text-slate-400 leading-relaxed mb-6">
          Motor de contenido autónomo con <strong class="text-white">6 agentes IA especializados</strong> (Brand → SEO → Copy → Visual → Publish). Escribe, diseña, puntúa y publica contenido de marca todos los días — sin que el cliente toque nada.
        </p>

        <!-- Arquitectura en tabla -->
        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-cyan-electric/40 transition-colors">
            <p class="font-mono text-xs text-cyan-electric mb-1">Backend Core</p>
            <p class="text-slate-400 text-xs leading-relaxed">FastAPI + Celery en Oracle ARM64. Auth JWT con Google OAuth. Pasarelas PayPal y MercadoPago con validación atómica.</p>
          </div>
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-cyan-electric/40 transition-colors">
            <p class="font-mono text-xs text-cyan-electric mb-1">AI Pipeline</p>
            <p class="text-slate-400 text-xs leading-relaxed">6 agentes orquestados en Celery. Generación de reels con Remotion en 2 vCPU. Scorer viral con DeepSeek.</p>
          </div>
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-cyan-electric/40 transition-colors">
            <p class="font-mono text-xs text-cyan-electric mb-1">Frontend</p>
            <p class="text-slate-400 text-xs leading-relaxed">Astro 7 SSR como Cloudflare Worker. Auth guard en middleware con JWT httpOnly cookie. React islands.</p>
          </div>
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-cyan-electric/40 transition-colors">
            <p class="font-mono text-xs text-cyan-electric mb-1">DB Schema</p>
            <p class="text-slate-400 text-xs leading-relaxed">PostgreSQL multi-tenant. Tablas: tenants, users, copy_variants, published_posts, social_accounts, bug_reports.</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-8">
          {['Python','FastAPI','Celery','Astro SSR','Cloudflare Workers','PostgreSQL','Remotion','DeepSeek'].map(t => (
            <span class="tech-tag">{t}</span>
          ))}
        </div>

        <a href="https://acmeagents.team" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 text-sm text-white border border-slate-600 px-5 py-2.5 rounded hover:border-cyan-electric hover:text-cyan-electric transition-all duration-200 font-mono">
          acmeagents.team
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- ── PROYECTO 2: Endonautas ── -->
  <div class="max-w-6xl mx-auto">
    <div class="endo-card grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Texto -->
      <div>
        <div class="flex items-center gap-2 mb-5">
          <span class="px-2.5 py-1 bg-zen-matcha/10 text-zen-matcha text-xs font-mono rounded border border-zen-matcha/20">B2C Platform</span>
          <span class="px-2.5 py-1 bg-slate-800 text-slate-400 text-xs font-mono rounded border border-slate-700">PWA</span>
          <span class="px-2.5 py-1 bg-slate-800 text-slate-400 text-xs font-mono rounded border border-slate-700">Django 6</span>
        </div>

        <div class="flex items-center gap-4 mb-2">
          <img src="/img/projects/endonautas-logo.png" alt="Endonautas Logo" class="h-12 w-auto object-contain drop-shadow-[0_0_8px_rgba(134,239,172,0.4)]" />
          <h3 class="text-3xl md:text-4xl font-bold text-white">Endonautas</h3>
        </div>
        <p class="text-zen-matcha font-mono text-sm mb-4">Plataforma B2C de Evaluación Psicológica y Autoconocimiento — Health Tech independiente</p>
        <p class="text-slate-400 leading-relaxed mb-6">
          El proyecto que no existía en el mercado, y lo constrúí. Motor de evaluación psicológica que procesa datos no estructurados de múltiples sistemas (psicometría, astrología, filosofa oriental) y los transforma en perfiles de autoconocimiento interactivos mediante arquitecturas RAG sobre LLMs. Diseñado desde el criterio clínico, construido con software de producción.
        </p>

        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-zen-matcha/40 transition-colors">
            <p class="font-mono text-xs text-zen-matcha mb-1">Espejo de Conflictos</p>
            <p class="text-slate-400 text-xs leading-relaxed">RAG con KnowledgeChunks + DeepSeek API. ChatMessage para contexto terapéutico persistente.</p>
          </div>
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-zen-matcha/40 transition-colors">
            <p class="font-mono text-xs text-zen-matcha mb-1">Visual Engine</p>
            <p class="text-slate-400 text-xs leading-relaxed">Three.js cosmos + Canvas 2D mandala. SPA navigation con presetForPath() sin recarga.</p>
          </div>
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-zen-matcha/40 transition-colors">
            <p class="font-mono text-xs text-zen-matcha mb-1">Cálculos</p>
            <p class="text-slate-400 text-xs leading-relaxed">kerykeion (astrología), sxtwl (Saju/BaZi). 34 símbolos en calculators.py de alta precisión.</p>
          </div>
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-zen-matcha/40 transition-colors">
            <p class="font-mono text-xs text-zen-matcha mb-1">Monetización</p>
            <p class="text-slate-400 text-xs leading-relaxed">Planes Free / Navegante / Practicante. Gating por feature con plan_utils.py. PWA installable.</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-8">
          {['Django 6','DeepSeek RAG','Three.js','Astro SSG','kerykeion','SQLite/PostgreSQL','Wagtail CMS','WhiteNoise'].map(t => (
            <span class="tech-tag">{t}</span>
          ))}
        </div>

        <a href="https://endonautas.cl" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 text-sm text-white border border-slate-600 px-5 py-2.5 rounded hover:border-zen-matcha hover:text-zen-matcha transition-all duration-200 font-mono">
          endonautas.cl
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>

      <!-- Visual: galería screenshots -->
      <div class="relative">
        <!-- Screenshot principal -->
        <div class="endo-main device-frame overflow-hidden rounded-xl shadow-2xl border border-slate-700/50">
          <img src="/img/endonautas/espejo.webp" alt="Endonautas Espejo de Conflictos" class="w-full block" loading="lazy" />
        </div>
        <!-- Galería debajo -->
        <div class="grid grid-cols-3 gap-4 mt-4">
          <div class="device-frame overflow-hidden rounded-lg border border-slate-700/50 shadow-lg">
            <img src="/img/endonautas/oraculo.webp" alt="Oráculo" class="w-full block" loading="lazy" />
          </div>
          <div class="device-frame overflow-hidden rounded-lg border border-slate-700/50 shadow-lg">
            <img src="/img/endonautas/tests.webp" alt="Tests psicométricos" class="w-full block" loading="lazy" />
          </div>
          <div class="device-frame overflow-hidden rounded-lg border border-slate-700/50 shadow-lg">
            <img src="/img/endonautas/terapeuta.webp" alt="Terapeuta IA" class="w-full block" loading="lazy" />
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ── PROYECTO 3: ARQit ── -->
  <div class="max-w-6xl mx-auto mt-40">
    <div class="arqit-card grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Visual: Browser Mockup scrollable -->
      <div class="relative h-[500px] lg:h-[600px] order-2 lg:order-1 arqit-desktop device-frame overflow-hidden rounded-xl shadow-2xl border border-slate-700/50 group bg-slate-900">
        <!-- Browser top bar -->
        <div class="h-10 bg-slate-950/80 backdrop-blur border-b border-slate-800 flex items-center px-4 gap-2 sticky top-0 z-10 w-full">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="mx-auto bg-slate-900 border border-slate-700/50 rounded-md px-3 py-1 text-[10px] text-slate-400 font-mono flex items-center gap-2">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            arqit.eead.cl
          </div>
        </div>
        
        <!-- Contenedor scrollable -->
        <div id="arqit-scroll-container" class="absolute top-10 inset-x-0 bottom-0 overflow-y-auto scrollbar-hide">
          <div class="flex flex-col">
            <img src="/img/projects/arqit-1.png" alt="ARQit Header" class="w-full block" loading="lazy" />
            <img src="/img/projects/arqit-2.png" alt="ARQit Sección 2" class="w-full block" loading="lazy" />
            <img src="/img/projects/arqit-3.png" alt="ARQit Sección 3" class="w-full block" loading="lazy" />
            <img src="/img/projects/arqit-4.png" alt="ARQit Sección 4" class="w-full block" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- Texto -->
      <div class="order-1 lg:order-2">
        <div class="flex items-center gap-2 mb-5">
          <span class="px-2.5 py-1 bg-red-500/10 text-red-400 text-xs font-mono rounded border border-red-500/20">Web Design</span>
          <span class="px-2.5 py-1 bg-slate-800 text-slate-400 text-xs font-mono rounded border border-slate-700">Corporativo</span>
        </div>

        <div class="flex items-center gap-4 mb-4">
          <h3 class="text-3xl md:text-4xl font-bold text-white">ARQit</h3>
        </div>
        <p class="text-slate-400 leading-relaxed mb-6">
          Agencia especializada en la creación de sitios web profesionales para estudios de arquitectura e ingeniería. Diseño inmersivo, portafolios interactivos y una estética rigurosa que eleva la identidad corporativa.
        </p>

        <div class="grid grid-cols-2 gap-3 mb-6">
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-red-500/40 transition-colors">
            <p class="font-mono text-xs text-red-400 mb-1">Frontend</p>
            <p class="text-slate-400 text-xs leading-relaxed">Arquitectura optimizada para performance extremo. Animaciones fluidas, scroll asíncrono y layouts precisos.</p>
          </div>
          <div class="bg-slate-900 border border-slate-700/50 rounded-lg p-4 hover:border-red-500/40 transition-colors">
            <p class="font-mono text-xs text-red-400 mb-1">UX/UI Design</p>
            <p class="text-slate-400 text-xs leading-relaxed">Diseño en Figma de alto nivel, prototipado hiperrealista enfocado en la usabilidad y la estética visual minimalista.</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 mb-8">
          {['Astro','Tailwind CSS','GSAP','Figma','Web Design'].map(t => (
            <span class="tech-tag">{t}</span>
          ))}
        </div>

        <a href="https://arqit.eead.cl" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 text-sm text-white border border-slate-600 px-5 py-2.5 rounded hover:border-red-400 hover:text-red-400 transition-all duration-200 font-mono">
          arqit.eead.cl
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </div>
  </div>

</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Header reveal
  gsap.to('.projects-header', {
    scrollTrigger: { trigger: '#proyectos', start: 'top 80%' },
    y: 0, opacity: 1, duration: 1, ease: 'power3.out'
  });

  // ACME card
  gsap.from('.acme-card', {
    scrollTrigger: { trigger: '.acme-card', start: 'top 80%' },
    y: 60, opacity: 0, duration: 1.2, ease: 'power3.out'
  });

  // ACME floating phones parallax
  gsap.to('.acme-mobile-1', {
    scrollTrigger: { trigger: '.acme-card', start: 'top bottom', end: 'bottom top', scrub: 1 },
    y: -60,
  });
  gsap.to('.acme-mobile-2', {
    scrollTrigger: { trigger: '.acme-card', start: 'top bottom', end: 'bottom top', scrub: 1.5 },
    y: -90,
  });

  // Endonautas card
  gsap.from('.endo-card', {
    scrollTrigger: { trigger: '.endo-card', start: 'top 80%' },
    y: 60, opacity: 0, duration: 1.2, ease: 'power3.out'
  });

  // Desktop screenshot subtle float
  gsap.to('.acme-desktop', {
    scrollTrigger: { trigger: '.acme-card', start: 'top bottom', end: 'bottom top', scrub: 1 },
    y: -30,
  });
  gsap.to('.endo-main', {
    scrollTrigger: { trigger: '.endo-card', start: 'top bottom', end: 'bottom top', scrub: 1 },
    y: -30,
  });

  // ARQit card
  gsap.from('.arqit-card', {
    scrollTrigger: { trigger: '.arqit-card', start: 'top 80%' },
    y: 60, opacity: 0, duration: 1.2, ease: 'power3.out'
  });
  
  gsap.to('.arqit-desktop', {
    scrollTrigger: { trigger: '.arqit-card', start: 'top bottom', end: 'bottom top', scrub: 1 },
    y: -30,
  });

  // ARQit auto-scroll preview
  const arqitScroll = document.getElementById('arqit-scroll-container');
  if (arqitScroll) {
    const autoScrollAnim = gsap.to(arqitScroll, {
      scrollTop: 450, // Hace scroll hacia abajo
      duration: 6,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
      paused: true
    });

    ScrollTrigger.create({
      trigger: '.arqit-card',
      start: 'top center',
      onEnter: () => autoScrollAnim.play(),
      onLeave: () => autoScrollAnim.pause(),
      onEnterBack: () => autoScrollAnim.play(),
      onLeaveBack: () => autoScrollAnim.pause()
    });

    arqitScroll.addEventListener('mouseenter', () => autoScrollAnim.pause());
    arqitScroll.addEventListener('mouseleave', () => autoScrollAnim.play());
    arqitScroll.addEventListener('touchstart', () => autoScrollAnim.pause());
  }
</script>
